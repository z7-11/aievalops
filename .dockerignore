# Install dependencies inside the image, not from the host machine.
**/.venv/
**/node_modules/
**/node_modules.failed-install-*/

# Git history and local editor settings.
.git/
.vscode/
.idea/

# Local environment files must not be baked into an image.
**/.env
**/.env.*
!**/.env.example

# Python bytecode, caches, and coverage reports.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.coverage
**/.coverage.*
**/coverage.xml
**/htmlcov/

# Generated evaluation, browser-test, and temporary output.
results/
test-results/
playwright-report/
output/
tmp/
**/*.log

# Operating system metadata.
**/.DS_Store
**/Thumbs.db

# Keep application code, templates, static files, knowledge, baselines,
# migrations, evaluation configs, tests, and dependency manifests available.
